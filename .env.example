NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
DATABASE_URL=file:./prisma/dev.db
# Пароль владельца вводится интерактивно: npm run owner:create
# Для РУЧНОГО пробного поиска (до 50 объектов и 3 ниш за раз).
# Публичный Overpass API — общедоступный ресурс, не production backend.
# Для постоянной работы замените на собственный/договорной Overpass endpoint.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# ПРИОРИТЕТ 1: 2ГИС Places API. Получите ключ у 2ГИС.
# Для постоянного сохранения организаций нужна соответствующая лицензия.
# Контакты требуют отдельного разрешения items.contact_groups.
DGIS_API_KEY=
DGIS_STORAGE_ALLOWED=false
DGIS_CONTACTS_ALLOWED=false
# ПРИОРИТЕТ 2: Яндекс API Поиска организаций.
# Стандартная лицензия не разрешает накопление CRM; включать хранение
# только при отдельном письменном разрешении на нужный сценарий.
YANDEX_MAPS_API_KEY=
YANDEX_STORAGE_ALLOWED=false
# Chromium/Lighthouse: включать только на отдельном непривилегированном процессе.
AUDIT_BROWSER_ENABLED=false
AUDIT_TIMEOUT_MS=90000
TRUST_PROXY=0
