{
  "name": "shumdev-lead-hunter",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "build": "sass styles/main.scss public/css/main.css --style=compressed --no-source-map",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "owner:create": "node scripts/create-owner.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration.mjs",
    "check": "node scripts/check.js",
    "db:backup": "node scripts/backup-db.js"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "express": "5.2.1",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.2.1",
    "zod": "^4.3.6",
    "dotenv": "^17.2.3",
    "multer": "^2.0.2",
    "exceljs": "^4.4.0",
    "csv-parse": "7.0.3",
    "cheerio": "^1.1.2",
    "ipaddr.js": "^2.3.0",
    "playwright": "^1.58.2",
    "lighthouse": "^13.0.1",
    "chrome-launcher": "^1.2.1",
    "@prisma/adapter-better-sqlite3": "7.10.0"
  },
  "devDependencies": {
    "sass": "^1.97.3",
    "supertest": "^7.2.2",
    "prisma": "7.10.0"
  },
  "overrides": {
    "uuid": "11.1.1",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
